# Exclude tracked HTML from language stats
_archive/*.html     linguist-generated
header/*.html       linguist-generated
include_footer.html linguist-generated

# (Optional) Count Rmd/Qmd as R so your work shows up
*.Rmd linguist-language=R
*.qmd linguist-language=R

# Exclude vendored libraries from language stats
_archive/wc-momentum/vendor/** linguist-vendored
wc-momentum/vendor/** linguist-vendored
site_libs/** linguist-vendored

# Historical R Markdown builds and deployed preview copies are generated.
# Hand-authored app sources (including their JavaScript) remain counted.
/*.html linguist-generated
_site/** linguist-generated
pr-*/** linguist-generated
